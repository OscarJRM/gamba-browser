{
  "name": "gamba-browser",
  "version": "0.1.0",
  "description": "Playwright harness over CDP for AI agents that automate your real Chrome, plus an MCP server.",
  "main": "src/browser.js",
  "bin": {
    "gamba-exec": "./bin/gamba-exec",
    "gamba-browser": "./src/cli.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs/PLAYBOOK.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:smoke": "GAMBA_TEST_BROWSER=1 node --test test/smoke.test.js",
    "doctor": "node src/cli.js doctor",
    "mcp": "node src/mcp.js"
  },
  "keywords": [
    "playwright",
    "cdp",
    "browser-automation",
    "ai-agents",
    "mcp",
    "chrome"
  ],
  "author": "Oscar Ramírez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OscarJRM/gamba-browser.git"
  },
  "homepage": "https://github.com/OscarJRM/gamba-browser",
  "bugs": {
    "url": "https://github.com/OscarJRM/gamba-browser/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  }
}
